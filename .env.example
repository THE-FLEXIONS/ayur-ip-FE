# Copy to .env (never commit .env). Provider API keys do NOT go here:
# they belong in backend/.env, on the server.

# The deployed API address lives in src/config/api.ts (DEPLOYED_API_URL).
# These optional settings override it.

# Where the Vite dev/preview server proxies /api. Set to http://localhost:5000
# to use a backend running on this machine.
API_PROXY_TARGET=

# API address for production builds.
VITE_API_BASE_URL=
