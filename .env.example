# AyurIP frontend environment
# Copy to `.env.local` for local development. On Render (static site), add it
# under Settings → Environment, then redeploy: Vite bakes it in at build time.

# Backend origin, no trailing slash.
# Local: http://localhost:4000   Render: https://<your-backend>.onrender.com
VITE_API_URL=http://localhost:4000
