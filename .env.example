# Copy to .env (never commit .env). These are read by the Vite dev/preview
# server only; without a VITE_ prefix they are not exposed to the browser.

# Gemini (create a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000

# Optional: when the AYUR-IP backend is running, proxy /api to it instead of
# calling Gemini from the dev server, e.g. http://localhost:5000
API_PROXY_TARGET=

# Optional: absolute backend URL for a deployed frontend (leave empty for same-origin /api)
VITE_API_BASE_URL=
