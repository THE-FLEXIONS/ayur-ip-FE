# Copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development

# Proxies in front of the app, so rate limits see real client IPs.
# 1 on Render; 0 when running directly.
TRUST_PROXY=0

# Frontend origins allowed to call this API (comma-separated).
# Not needed in local dev, where Vite proxies /api to this server.
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# Gemini (create a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
# Keep false: stops Google from storing chat interactions.
GEMINI_STORE_INTERACTIONS=false

# Herbal Library (GET /api/herbs/search)
# PostgreSQL cache; the herbs table is created at startup. Leave empty to cache in memory.
DATABASE_URL=
# Trefle token from https://trefle.io/profile. Leave empty to search only the
# cache and the built-in seed herbs.
HERBAL_API_KEY=
HERBAL_API_BASE_URL=https://trefle.io/api/v1
HERBAL_TIMEOUT_MS=10000
# Keep Trefle's full record in raw_data only if Trefle's current terms allow it.
HERBAL_STORE_RAW=false

# Not used yet. Added with the RAG and translation endpoints.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMS=768
# BHASHINI_USER_ID=
# BHASHINI_API_KEY=
# BHASHINI_PIPELINE_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
# BHASHINI_PIPELINE_ID=
