# Copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development

# Frontend origins allowed to call this API (comma-separated).
# Not needed in local dev, where Vite proxies /api to this server.
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# Gemini (create a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
# Keep false: stops Google from storing chat interactions.
GEMINI_STORE_INTERACTIONS=false

# Not used yet. Added with the RAG, translation and Herbal Library endpoints.
# DATABASE_URL=postgresql://user:password@localhost:5432/ayur_ip_db
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
